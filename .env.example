# En Netlify: Project configuration → Environment variables (no subir esta clave a GitHub)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Activa la IA para las visitas públicas después de probarla
ENABLE_PUBLIC_AI=false
# Límite orientativo por instancia; el control de solicitudes real lo hace Netlify rateLimit
MAX_OUTPUT_TOKENS=650
